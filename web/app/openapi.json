          "ended": {
            "type": "string",
            "title": "Ended"
          },
          "outcome": {
            "type": "string",
            "title": "Outcome"
          },
          "changes": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Changes",
            "default": {}
          },
          "cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost"
          }
