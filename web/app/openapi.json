        "type": "object",
        "required": [
          "status",
          "waiting",
          "sessions"
        ],
        "title": "Modeler"
      },
      "Observation": {
        "properties": {
          "device": {
            "type": "string",
            "title": "Device"
          },
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "body": {
            "type": "string",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "device",
          "start",
          "end",
          "body"
        ],
        "title": "Observation"
      },
      "Operation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "confidence": {
            "type": "integer",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text",
          "confidence"
        ],
        "title": "Operation"
      },
      "Problem": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "path",
          "error"
        ],
        "title": "Problem"
      },
      "Relations": {
        "properties": {
          "conflicts_with": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Conflicts With"
          },
          "facilitates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Facilitates"
          },
          "serves": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Serves"
          }
        },
        "type": "object",
        "required": [
          "conflicts_with",
          "facilitates",
          "serves"
        ],
        "title": "Relations"
      },
      "SchedulerState": {
        "properties": {
