                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Since"
          },
          "until": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Until"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "state"
        ],
        "title": "SchedulerState",
        "description": "The modeler's `status.json`; `not running` when no scheduler holds its lock."
      },
