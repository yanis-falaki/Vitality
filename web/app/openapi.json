          "operations": {
            "items": {
              "$ref": "#/components/schemas/Operation"
            },
            "type": "array",
            "title": "Operations"
          },
          "screenshots": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Screenshots"
          },
          "actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Actions"
          }
        },
        "type": "object",
        "required": [
          "interaction",
          "start",
          "end",
          "observation",
          "operations",
          "screenshots",
          "actions"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InteractionSummary": {
        "properties": {
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "operations": {
            "type": "integer",
            "title": "Operations"
          },
          "screenshots": {
            "type": "integer",
            "title": "Screenshots"
          },
          "first_operation": {
            "type": "string",
            "title": "First Operation"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end",
          "operations",
          "screenshots",
          "first_operation"
        ],
        "title": "InteractionSummary",
        "description": "What the views need about one interaction without fetching its evidence."
      },
      "Interactions": {
        "additionalProperties": {
          "$ref": "#/components/schemas/InteractionSummary"
        },
        "type": "object",
        "title": "Interactions",
        "description": "Interaction summaries by name (`GET /api/interactions`)."
      },
      "Model": {
        "properties": {
          "strivings": {
            "items": {
              "$ref": "#/components/schemas/Striving"
            },
            "type": "array",
            "title": "Strivings"
          },
          "activities": {
            "items": {
              "$ref": "#/components/schemas/Activity"
            },
            "type": "array",
            "title": "Activities"
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "type": "array",
            "title": "Actions"
          },
          "problems": {
            "items": {
              "$ref": "#/components/schemas/Problem"
            },
            "type": "array",
            "title": "Problems"
          }
        },
        "type": "object",
        "required": [
          "strivings",
          "activities",
          "actions",
          "problems"
        ],
        "title": "Model"
      },
      "Modeler": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/SchedulerState"
          },
          "waiting": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
