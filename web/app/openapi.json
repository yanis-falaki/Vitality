        "type": "object",
        "required": [
          "id",
          "summary",
          "start",
          "end",
          "interactions",
          "part_of",
          "confidence"
        ],
        "title": "Action",
        "description": "An action as the model lists it: without its body or operations, which `ActionDetail` adds."
      },
      "ActionDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "interactions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interactions"
          },
          "part_of": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Part Of"
          },
          "confidence": {
            "type": "integer",
            "title": "Confidence"
          },
          "operations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Operations"
          },
          "body": {
            "type": "string",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "id",
          "summary",
          "start",
          "end",
          "interactions",
          "part_of",
          "confidence",
          "operations",
          "body"
        ],
        "title": "ActionDetail"
      },
      "Activity": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "part_of": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Part Of"
          },
          "hinders": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hinders"
          },
          "confidence": {
            "type": "integer",
            "title": "Confidence"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "first_seen": {
            "type": "string",
            "title": "First Seen"
          },
          "last_seen": {
            "type": "string",
            "title": "Last Seen"
          },
          "locked": {
            "type": "boolean",
