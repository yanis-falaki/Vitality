        "title": "Activity"
      },
      "Evidence": {
        "properties": {
          "interaction": {
            "type": "string",
            "title": "Interaction"
          },
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "observation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Observation"
              },
