#!/usr/bin/env bash
# The owner's helper for running Vitality with Docker Compose. Run it from anywhere; it works in
# the folder it lives in.
#
#   ./vitality setup            create .env, the data folders and the model repo; check the logins
#   ./vitality status           containers, then the server's and the observer's status
#   ./vitality logs [service]   follow the logs (service: server or observer; default: both)
#   ./vitality upgrade          fast-forward to the newest main, then rebuild and restart
#   ./vitality lab <args>       run vitality-lab (lab/README.md) with the settings from .env
#
# Every docker and git command is printed (after a "$ ") before it runs, so nothing is hidden.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

# == Helpers ==

# Print a command the way a shell prompt would show it.
show() { printf '$ %s\n' "$*"; }

# Print a command, then run it.
run() { show "$@"; "$@"; }

# Stop with a message.
die() { echo "vitality: $*" >&2; exit 1; }

# The last value NAME has in .env (no value if the file or the line is missing).
# Comment lines are ignored; surrounding quotes are removed; " # ..." after a value is a comment.
# A "# ..." right after an empty "NAME=" is kept, because that is what compose reads there.
env_file_value() {
    [[ -f .env ]] || return 0
    local line value=""
    while IFS= read -r line || [[ -n $line ]]; do   # also a last line without a newline
        if [[ $line =~ ^[[:space:]]*"$1"[[:space:]]*=(.*)$ ]]; then
            value="${BASH_REMATCH[1]}"
        fi
    done < .env
    value="${value#"${value%%[![:space:]]*}"}"   # trim leading blanks
    if [[ $value =~ ^\"([^\"]*)\" || $value =~ ^\'([^\']*)\' ]]; then
        value="${BASH_REMATCH[1]}"
    else
        value="${value%%[[:space:]]#*}"
    fi
    value="${value%"${value##*[![:space:]]}"}"   # trim trailing blanks
    printf '%s' "$value"
}

# The data folder, found the way compose.yaml finds it: the environment, else .env, else the default.
data_dir() {
    local dir="${VITALITY_DATA:-}"
    [[ -n $dir ]] || dir="$(env_file_value VITALITY_DATA)"
    printf '%s' "${dir:-$HOME/vitality-data}"
}

# == Commands ==

# Make the model folder a git repo, once, holding the two starting files. The files already
# there are never overwritten. The repo is the modeler's history; the observer only fills in
# observations/ and operations/, which the modeler's commits will pick up.
setup_model_repo() {
    local model="$1" template
    [[ -e $model/.git ]] && return 0
    run git -C "$model" init -q
    for template in user-context.md modeler-notes.md; do
        if [[ -e $model/$template ]]; then
            echo "$template already exists in the model folder; leaving it alone."
        else
            run cp "usermodel/templates/$template" "$model/$template"
        fi
    done
    run git -C "$model" add user-context.md modeler-notes.md
    # Only when git has no identity of its own (a fresh VM): a commit needs one.
    local identity=()
    show git -C "$model" config user.email
    if [[ -z "$(git -C "$model" config user.email || true)" ]]; then
        identity=(-c user.name=Vitality -c user.email=vitality@localhost)
    fi
    run git -C "$model" ${identity[@]+"${identity[@]}"} commit -q -m "model: start"
    echo "The model folder is a git repo now (commit 'model: start')."
}

# Create .env, the data folders and the model repo, and check the logins. Safe to rerun.
cmd_setup() {
    if [[ -f .env ]]; then
        echo ".env already exists; leaving it alone."
    else
        cp .env.example .env
        echo "Created .env from .env.example."
    fi
    chmod 600 .env   # it holds the API key: only the owner may read it

    local data
    data="$(data_dir)"
    mkdir -p "$data/server/captures" "$data/model" "$data/observer"
    mkdir -p "$data/model/observations" "$data/model/operations" "$data/modeler"
    chmod 700 "$data"   # it holds screenshots: only the owner may look inside
    echo "Data folders are in place under $data (only you can read them)"

    setup_model_repo "$data/model"

    # The login is the file ~/.claude/.credentials.json. The observer no longer uses it (it calls the
    # API with a key); the modeler of a later phase will, through a ~/.claude mount.
    # On a desktop with a keyring (gnome-keyring, KWallet) Claude Code keeps the login there instead,
    # and the container cannot use it: run the VM side on a server.
    if [[ ! -f $HOME/.claude/.credentials.json ]]; then
        die "Claude Code is not logged in on this machine with a file-based login
(~/.claude/.credentials.json is missing). Run 'claude', then '/login' inside it, and run
./vitality setup again. On a desktop with a keyring the login is not stored in that file, so
run the VM side on a server."
    fi

    if [[ -z "$(env_file_value ANTHROPIC_API_KEY)" ]]; then
        die "ANTHROPIC_API_KEY is empty in .env. The observer needs an API key from your Claude
Console organization (a workspace API key): put it on its own line as ANTHROPIC_API_KEY=sk-ant-...
and run ./vitality setup again."
    fi

    local allowed
    allowed="$(env_file_value SERVER_ALLOWED_CLIENTS)"
    if [[ -z $allowed || $allowed == \#* ]]; then
        echo "Next: set SERVER_ALLOWED_CLIENTS in .env to your clients' Tailscale device names,"
        echo "on its own line, no trailing comment. Then: docker compose up -d"
    else
        echo "Ready. Start Vitality with: docker compose up -d"
    fi
}

# Show the containers, then what the server and the observer say; carry on past a failing part.
cmd_status() {
    local failed=0
    run docker compose ps || failed=1
    run docker compose run --rm --no-deps server vitality-server status || failed=1
    run docker compose run --rm --no-deps observer vitality-observer status || failed=1
    echo "data: $(data_dir)"
    return "$failed"
}

# Follow the logs of both services, or of the one named.
cmd_logs() {
    run docker compose logs -f "$@"
}

# Fast-forward to the newest main (only from a clean main), then rebuild and restart.
cmd_upgrade() {
    show git rev-parse --abbrev-ref HEAD
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD)"
    [[ $branch == main ]] || die "upgrade only runs on main (this is '$branch'). Switch with: git switch main"

    show git status --porcelain --untracked-files=no
    [[ -z "$(git status --porcelain --untracked-files=no)" ]] \
        || die "tracked files are modified; commit or stash them first (see: git status)"

    run git fetch origin main

    show git rev-list --count HEAD..origin/main
    if [[ "$(git rev-list --count HEAD..origin/main)" == 0 ]]; then
        # Still go on to the build below: a build that failed last time can then be retried.
        echo "Already up to date."
    else
        echo "New commits:"
        run git log --oneline HEAD..origin/main
        run git merge --ff-only origin/main \
            || die "cannot fast-forward: this copy has commits of its own that origin/main lacks"
    fi

    run docker compose up -d --build
}

# Run vitality-lab with the API key, the observer settings and LAB_DIR from .env (a variable already
# set in the environment wins, as with compose). Values are passed in the environment, never printed.
cmd_lab() {
    local name value
    for name in ANTHROPIC_API_KEY OBSERVER_MODEL OBSERVER_EFFORT OBSERVER_PARALLEL \
                OBSERVER_CALL_TIMEOUT_SECONDS LAB_DIR; do
        if [[ -z "${!name+set}" ]]; then
            value="$(env_file_value "$name")"
            [[ -n $value ]] && export "$name=$value"
        fi
    done
    show uv run --project lab vitality-lab "$@"
    exec uv run --project lab vitality-lab "$@"
}

# Say what the commands are.
usage() {
    cat <<'EOF'
usage: ./vitality <command>

  setup             create .env, the data folders and the model repo; check the logins
  status            containers, then the server's and the observer's status
  logs [service]    follow the logs (service: server or observer; default: both)
  upgrade           fast-forward to the newest main, then rebuild and restart
  lab <args>        run vitality-lab with the settings from .env (see lab/README.md)
EOF
}

# == Main ==

case "${1:-}" in
    setup)   cmd_setup ;;
    status)  cmd_status ;;
    logs)    shift; cmd_logs "$@" ;;
    upgrade) cmd_upgrade ;;
    lab)     shift; cmd_lab "$@" ;;
    *)       usage >&2; exit 2 ;;
esac
