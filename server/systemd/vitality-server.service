[Unit]
Description=Vitality server
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
User=vitality
ExecStart=/opt/vitality-server/bin/vitality-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/vitality

[Install]
WantedBy=multi-user.target
