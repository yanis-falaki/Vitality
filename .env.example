# Vitality settings. Copy to .env (git-ignored) and edit: cp .env.example .env
# Only SERVER_ALLOWED_CLIENTS and ANTHROPIC_API_KEY must be filled in; everything else has the default shown.
# (Comments sit on their own lines: after an empty value, a trailing "# ..." would become the value.)

# Where the data lives, and who owns it. compose.yaml supplies these defaults, so leave them
# commented out unless yours differ.
#   VITALITY_DATA: the data folder; unset: $HOME/vitality-data
#   VITALITY_UID / VITALITY_GID: who owns the data; the containers run as this user and group
# VITALITY_DATA=/home/you/vitality-data
# VITALITY_UID=1000
# VITALITY_GID=1000
#   LAB_DIR: the lab's folder (./vitality lab; see lab/README.md); unset: $HOME/vitality-lab
# LAB_DIR=/home/you/vitality-lab

# Served on the VM's Tailscale address only.
SERVER_PORT=8100
# Comma-separated Tailscale device names that may upload, e.g. laptop
SERVER_ALLOWED_CLIENTS=

# The observer's Anthropic API key, from your Claude Console organization (a workspace API key).
# Required: the observer will not start without it.
ANTHROPIC_API_KEY=
# direct: one request per interaction, answered at once. batch: the same requests through the
# Batches API at half price; observations then arrive minutes to hours later.
OBSERVER_MODE=direct
# Most interactions observed at the same time (direct mode).
OBSERVER_PARALLEL=4
# The model that writes the observations.
OBSERVER_MODEL=claude-sonnet-5-5
# How hard it thinks: low, medium, high, xhigh or max. Transcribing needs sight more than thought.
OBSERVER_EFFORT=low
# A request running longer than this many seconds is given up on.
OBSERVER_CALL_TIMEOUT_SECONDS=600

# Modeler: the modeler service and ./vitality lab run modeler. Uses your Claude login, not the API key.
# The model of the Claude Code session.
# MODELER_MODEL=claude-opus-5-5
# How hard it thinks: low, medium, high, xhigh or max.
# MODELER_EFFORT=high
# Most operations offered to one run.
# MODELER_MAX_OPERATIONS=500
# A run lasting longer than this many seconds is given up on.
# MODELER_RUN_TIMEOUT_SECONDS=3600

# Web: the private, read-only web app (web/README.md), served on this port of the VM. exe.dev's
# private proxy serves it to you (only) at https://vitality-librarian.exe.xyz:<port>/.
WEB_PORT=4000
